# Server-only values. Never expose these through VITE_ variables.
PORT=8080
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# Generate 32 random bytes and encode as 64 hexadecimal characters.
PROVIDER_CREDENTIALS_ENCRYPTION_KEY=64_HEX_CHARACTERS
# Optional: exact origin of the deployed PWA, e.g. https://studio.example.com
APP_ORIGIN=https://YOUR_FRONTEND_DOMAIN
POLL_INTERVAL_MS=5000
