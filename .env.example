# Public Supabase client settings (safe for browser use when Row Level Security is enabled)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Never put SUPABASE_SERVICE_ROLE_KEY or AI provider secrets in VITE_ variables.
# Server-only secrets belong in the backend hosting provider's secret settings.
